{
  "name": "chameleon",
  "version": "0.1.0",
  "description": "Per-project generated themes for Claude (claude.ai, Claude Desktop) and Claude Code.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chameleon": "cli/chameleon.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/build.mjs && node test/e2e/extension.e2e.mjs",
    "preview": "node scripts/build.mjs && node cli/chameleon.js preview",
    "test:plugin": "node scripts/build.mjs && claude plugin validate claude-code-plugin && claude plugin test claude-code-plugin",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tabler/icons": "^3.49.0",
    "playwright": "^1.56.1"
  }
}
